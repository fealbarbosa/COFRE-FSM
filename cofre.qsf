set_location_assignment PIN_H19 -to leds_vermelhos[7]
set_location_assignment PIN_J17 -to leds_vermelhos[8]
set_location_assignment PIN_G17 -to leds_vermelhos[9]
set_location_assignment PIN_J15 -to leds_vermelhos[10]
set_location_assignment PIN_H16 -to leds_vermelhos[11]
set_location_assignment PIN_J16 -to leds_vermelhos[12]
